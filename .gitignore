# 环境与密钥
.env
*.env
.env.*
# 唯一例外:生产配置模板(无真实值,占位 CHANGE_ME),其余 .env* 仍一律忽略
!configs/.env.prod.example

# Go
bin/
*.exe
*.test
# 依赖不再入库:改由 go.sum 校验 + 模块代理(GOPROXY)下载(见 Dockerfile)
vendor/

# 构建产物
dist/
build/

# 本地数据
data/
*.db
*.sqlite

# AI 网关自签 CA(仅 lab 放置,不进 git;compose 挂 ./certs:/certs:ro)
certs/

# Windows 残留
*:Zone.Identifier

# Obsidian 缓存
.DS_Store
.obsidian/
*.tmp

# Obsidian vault(独立 git 仓库,与代码仓库分离)
PIKS-Vault/
