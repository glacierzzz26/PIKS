# PIKS 生产配置模板。lab 实例化为 /home/rguo/piks/.env(chmod 600)。真实值只填在 lab,永不进 git。
# 用法(脚本内):set -a; source /home/rguo/piks/.env; set +a
#
# 数据库口令(同时被 compose 的 postgres 服务与 DATABASE_URL 使用,必须一致)
PIKS_DB_PASSWORD=CHANGE_ME
# 容器内通过服务名访问(postgres 在 compose 网络 piks 内)
PIKS_DATABASE_URL=postgres://piks:CHANGE_ME@postgres:5432/piks?sslmode=disable

# 迭代 5-2:AI 配置权威源 = app_config 表(Web /settings 页编辑),不再经环境变量。
# vault/GitHub 已下线(Web 直读 PG),PIKS_VAULT_* 与 PIKS_AI_* 均不再读取,无需配置。

# 日管线护栏(issue #76;可选,不填用默认值)。脚本内直接读环境变量,故 dev 侧 `deploy.sh`
# 同步脚本时**不会**带上这两个值 —— 要在 lab 生效需在 crontab 里导出,或写进本文件并由
# cron 加载(当前 crontab 直接调脚本,不 source 本文件 ⇒ 默认值即实际值)。
# PIKS_STEP_TIMEOUT=1800   # 单步 wall-clock 上限(秒),默认 30 分钟
# PIKS_MAX_RETRY=5         # 同一步当日连续失败上限,超过则当日放弃并告警

# 同花顺自选凭据写入门控(issue #87 / #78;可选)。同花顺账号密码/cookie 落在
# app_config 表(ths_account / ths_password / ths_cookie),由 piks-watch-sync 常驻服务读取。
# 🔴 默认**关闭**:PIKS 可公网访问且无鉴权(#78),允许任意人写凭据 ⇒ 攻击者可覆盖你的凭据
#    把你锁在门外。故默认只允许在 lab 直接写 app_config 表。
#    仅在 lab 内网部署、确知无人可访问 /settings 时,才设 1 打开页面写入。
# PIKS_ALLOW_THS_CRED_UI=0
